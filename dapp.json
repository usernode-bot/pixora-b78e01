{
  "description": "AI toolkit for creating and preparing commercial visual assets for stock libraries",
  "llm": {
    "purpose": "Turns your idea into an image prompt and microstock metadata",
    "suggested_daily_cap_cents": 100
  },
  "secrets": [],
  "tests": [
    {
      "id": "home.default",
      "name": "Home renders with sidebar",
      "path": "/",
      "expectSelector": "#nav",
      "expectText": "PIXORA",
      "visual": true,
      "impact": ["public/**", "server.js"]
    },
    {
      "name": "First-run guide renders",
      "path": "/",
      "expectSelector": "#onboarding-dropzone",
      "expectText": "Convert images in your browser"
    },
    {
      "name": "Creative workspace renders",
      "path": "/creative",
      "expectSelector": "#creative-generate"
    },
    {
      "name": "Creative AI assistant button renders",
      "path": "/creative",
      "expectSelector": "#creative-ai",
      "expectText": "AI"
    },
    {
      "name": "Creative manual mode renders without AI",
      "path": "/creative",
      "expectSelector": "#creative-prompt-build"
    },
    {
      "id": "creative.header-toolbar",
      "name": "Creative header shows the toolbar beside Generate",
      "path": "/creative",
      "expectSelector": "#creative-toolbar",
      "expectText": "Export",
      "visual": true,
      "impact": ["public/js/tools/creative.js", "public/js/ui.js", "styles/tailwind-input.css", "tailwind.config.js"]
    },
    {
      "name": "Upscale workspace renders",
      "path": "/upscale",
      "expectSelector": "#upscale-btn"
    },
    {
      "name": "Remove Background workspace renders",
      "path": "/remove-background",
      "expectSelector": "#removebg-btn"
    }
  ],
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🎨"
  }
}
